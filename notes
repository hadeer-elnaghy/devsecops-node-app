1- setup

- SonarQube
# 1. Create the Docker network
docker network create devsecops-net

# 2. Run the SonarQube container on the network
docker run -d \
  --name sonarqube \
  --network devsecops-net \
  -p 9000:9000 \
  sonarqube:lts-community

#Important Note for Jenkins: Since SonarQube is now running inside Docker on the devsecops-net network, if Jenkins is also running in a Docker container, attach Jenkins to devsecops-net (docker network connect devsecops-net jenkins-local) so Jenkins can access SonarQube directly via the container name

# then login on http://localhost:9000 with user admin and password admin
# ceate SonarQube User Token (from SonarQube -> My Account -> Security)

- snyk
create account on https://snyk.io
generte peronal access token from account seettings

- dockerhub
get username and password

